# macOS
.DS_Store

# 任意层级下名为 tmp 的目录（gitignore 中不带前导 / 的规则自动匹配任意深度，
# 已覆盖 .acecode/tmp/、app/xxx/tmp/ 等；.acecode/tmp 也在此列）
tmp/

# Swift Package Manager / Xcode 构建产物
.build/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/

# 编辑器
.idea/
.vscode/
*.swp

# 采集/下载暂存目录（体积约 70MB，内容与 app/Resources 重复，如需纳入版本库请删除下一行）
_download/
