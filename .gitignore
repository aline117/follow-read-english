# macOS
.DS_Store

# 任意层级下名为 tmp 的目录（gitignore 中不带前导 / 的规则自动匹配任意深度，
# 已覆盖 .acecode/tmp/、app/xxx/tmp/ 等；.acecode/tmp 也在此列）
tmp/

# Swift Package Manager / Xcode 构建产物
.build/
.build-xcode/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/

# Python 工具
__pycache__/
*.pyc

# 编辑器
.idea/
.vscode/
*.swp

# 内容服务的数据目录：脚本进 git，学期包/媒体数据不进
content-service/packs/
content-service/media/

# 媒体素材与产物（听和看）：只在家里电脑 / iPad 上存在，不进仓库
# 用 /media/ 只匹配仓库根，避免误伤 app/Sources/**/Media/ 目录（Windows 上大小写不敏感）
/media/
*.mp4
*.wav
# 已入库的句型音频保留
!app/Resources/Curriculum/sentences/**/*.wav
