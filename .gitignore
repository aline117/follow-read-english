# macOS
.DS_Store

# 任意层级下名为 tmp 的目录（gitignore 中不带前导 / 的规则自动匹配任意深度，
# 已覆盖 .acecode/tmp/、app/xxx/tmp/ 等；.acecode/tmp 也在此列）
tmp/

# Swift Package Manager / Xcode 构建产物
.build/
.build-xcode/
.swiftpm/
DerivedData/
*.xcuserstate
xcuserdata/

# 编辑器
.idea/
.vscode/
*.swp

# 采集/下载暂存目录（体积约 70MB，内容与 app/Resources 重复）
# 只放行内容管线与内容服务脚本（tasks 7.5/7.7）；学期包与媒体不进 git
_download/*
!_download/README.md
!_download/build_resources.py
!_download/serve.py
!_download/serve.js
!_download/serve.bat

# 媒体素材与产物（听和看）：只在家里电脑 / iPad 上存在，不进仓库
# 用 /media/ 只匹配仓库根，避免误伤 app/Sources/**/Media/ 目录（Windows 上大小写不敏感）
/media/
*.mp4
*.wav
# 已入库的句型音频保留
!app/Resources/Curriculum/sentences/**/*.wav
